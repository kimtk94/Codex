    "healthy_reference_age_max": 75
  },
  "pace": {
    "min_visits": 3,
    "min_followup_years": 4.0,
    "accelerated_threshold_sd": 0.5
  },
  "clustering": {
    "k_min": 2,
    "k_max": 6,
    "min_complete_organs": 3,
    "random_state": 20260927
  }
