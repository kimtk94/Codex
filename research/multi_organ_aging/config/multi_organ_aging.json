    "metabolic": {
      "features": ["glucose", "hba1c", "insulin", "total_cholesterol", "hdl", "ldl", "triglyceride", "tyg", "bmi", "waist_cm"],
      "min_features": 4
    },
    "renal": {
      "features": ["creatinine", "egfr_2021", "bun", "uric_acid", "uacr"],
      "min_features": 2
    },
    "hepatic": {
      "features": ["ast", "alt", "ggt", "albumin", "bilirubin", "alp"],
      "min_features": 3
    },
    "inflammatory_hematologic": {
