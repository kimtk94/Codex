      "min_features": 3
    },
    "pulmonary": {
      "features": ["fvc", "fev1", "fev1_fvc"],
      "min_features": 2
    }
  },
  "clock": {
    "min_rows": 500,
    "min_subjects": 300,
    "min_nonmissing_fraction": 0.50,
    "group_folds": 5,
    "random_state": 20260927,
    "alphas": [0.001, 0.003, 0.01, 0.03, 0.1, 0.3, 1.0],
    "l1_ratios": [0.05, 0.2, 0.5, 0.8, 0.95],
