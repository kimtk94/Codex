+def collect_active_prepayment_project_ids(conn):
+    """Read active Prepayment decisions from durable SQLite, not the 30-day view.
+
+    If the visible Skipped tab is empty because of retention, its underlying
+    Prepayment decisions must still suppress false SIF reminders until the
+    project's real production stage advances beyond SIF.
+    """
+    project_ids = set()
+    for info in load_active_contract_sif_skips(conn).values():
+        snapshot = info.get("snapshot") or {}
+        if not isinstance(snapshot, dict):
+            continue
+        is_prepayment = (
+            normalize_text(info.get("skip_reason", "")).startswith("prepayment")
+            or checkbox_is_checked(snapshot.get(SAMPLE_INTAKE_PREPAYMENT_COLUMN, ""))
+        )
+        if not is_prepayment:
+            continue
+        project_id = canonical_sif_project_id(
+            snapshot.get("project_id", "") or snapshot.get("AMEA No.", "")
+        )
+        if project_id:
+            project_ids.add(project_id)
+    return project_ids
+
+
+def build_contract_sif_skip_history(conn, now=None):
+    """Persistent read-only archive of *all* contract SIF skip records.
+
+    This output MUST NOT be fed into sync_contract_sif_skip_actions_from_frames;
+    only the existing Skipped tab has a restore checkbox. Keep legacy
+    retention behavior in the live Tracker completely unchanged.
+    """
+    now = now or datetime.now(KST)
+    if now.tzinfo is None:
+        now = now.replace(tzinfo=KST)
+    rows = conn.execute(
+        """SELECT record_id, is_active, skip_reason, skipped_at,
+                  restored_at, snapshot_json FROM contract_sif_skips
+           ORDER BY skipped_at DESC, record_id"""
+    ).fetchall()
+    result = []
+    for record_id, is_active, reason, skipped_at, restored_at, raw in rows:
+        try:
+            snapshot = json.loads(raw) if raw else {}
+            if not isinstance(snapshot, dict):
+                snapshot = {}
+        except (TypeError, ValueError):
+            snapshot = {}
+        reference = clean_text(snapshot.get("Date", "")) or clean_text(
+            snapshot.get("contract_created_at", "")
+        )
+        parsed = pd.to_datetime(reference, errors="coerce")
+        age = ""
+        if not pd.isna(parsed):
+            try:
+                if getattr(parsed, "tzinfo", None) is None:
+                    parsed = parsed.tz_localize(KST)
+                else:
+                    parsed = parsed.tz_convert(KST)
+                age = max(0, (now.date() - parsed.date()).days)
+            except (TypeError, ValueError):
+                age = ""
+        workflow = clean_text(snapshot.get("workflow_status", ""))
+        reason_text = clean_text(reason)
+        is_prepayment = (
+            reason_text.lower().startswith("prepayment")
+            or checkbox_is_checked(snapshot.get(SAMPLE_INTAKE_PREPAYMENT_COLUMN, ""))
+        )
+        if workflow in SAMPLE_INTAKE_TERMINAL_STATUSES:
+            visibility = "승인 완료 - Tracker 표시 제외"
+        elif isinstance(age, int) and age > SAMPLE_INTAKE_RETENTION_DAYS:
+            visibility = "30일 초과 - Tracker 표시 제외"
+        else:
+            visibility = "Tracker 후보 (현재 단계 재검증 필요)"
+        result.append({
+            "record_id": clean_text(record_id),
+            "is_active": bool(is_active),
+            "Contract No.": clean_text(snapshot.get("Contract No.", "")),
+            "AMEA No.": clean_text(snapshot.get("AMEA No.", "") or snapshot.get("project_id", "")),
+            "Institution": clean_text(snapshot.get("Institution", "")),
+            "Customer Name": clean_text(snapshot.get("Customer Name", "")),
+            "skip_reason": reason_text,
+            "Prepayment": bool(is_prepayment),
+            "skipped_at": clean_text(skipped_at),
+            "restored_at": clean_text(restored_at),
+            "reference_date": reference,
+            "age_days": age,
+            "workflow_status": workflow,
+            "tracker_visibility": visibility,
+            "history_note": "조회 전용 / 복원은 별도 승인 및 원본 상태 재검증 필요",
+        })
+    return pd.DataFrame(result, columns=SAMPLE_INTAKE_SKIP_HISTORY_COLUMNS)
+
