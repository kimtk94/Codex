# --- Kalman pipeline / Neon ---
DATABASE_URL_WRITER=
# Drive-backed state. scripts/install_gdrive.sh mounts gdrive: here at boot.
KALMAN_DATA_ROOT=/mnt/gdrive
KALMAN_ENV_FILE=/opt/kalman/.env

# KR authenticated freshness fallback
KRX_ID=
KRX_PW=

# US / macro inputs used by the existing Unified lineage
FRED_API_KEY=
ECOS_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Market Data V2 (SHADOW ONLY) ---
# Dedicated venv; do not merge FinanceDataReader into the production gateway venv.
KALMAN_MARKET_V2_OUTPUT_DIR=/mnt/gdrive/Market_Data/v2
KALMAN_MARKET_V2_START_DATE=2024-01-01
KALMAN_MARKET_V2_END_DATE=

# --- Seeking Alpha x US x BTC ---
# Canonical history consumed by the feature worker.
KALMAN_SA_INPUT_CSV=/mnt/gdrive/SeekingAlpha/seeking_alpha_daily.csv
KALMAN_SA_OUTPUT_DIR=/mnt/gdrive/Market_Features/sa_us_btc
KALMAN_SA_START_DATE=2022-01-01
KALMAN_SA_END_DATE=
# 0 only when the SA snapshot is available before the modeled market session.
KALMAN_SA_ASOF_LAG_BDAYS=0
# Keep false until SA data is mandatory for production.
KALMAN_SA_REQUIRED=false

# Collector mode: disabled | drop_csv | licensed_http
# Do not automate scraping of the normal SA website. licensed_http is for an
# authorized/licensed API or data feed supplied for your account/partnership.
KALMAN_SA_COLLECTOR_MODE=disabled

# drop_csv mode: a permitted/exported file placed here is normalized + accumulated.
KALMAN_SA_DROP_CSV=/mnt/gdrive/SeekingAlpha/incoming/seeking_alpha_latest.csv
KALMAN_SA_ARCHIVE_DIR=/mnt/gdrive/SeekingAlpha/archive
KALMAN_SA_COLLECTOR_STATE=/opt/kalman/state/sa_collector.json

# licensed_http mode: keep the real endpoint/token only in /opt/kalman/.env.
KALMAN_SA_FEED_URL=
KALMAN_SA_FEED_TOKEN=
KALMAN_SA_FEED_AUTH_HEADER=Authorization
KALMAN_SA_FEED_AUTH_SCHEME=Bearer
KALMAN_SA_FEED_FORMAT=auto
# Optional dotted JSON path, e.g. data.rows. Blank auto-detects data/results/rows/items.
KALMAN_SA_FEED_JSON_PATH=
KALMAN_SA_FEED_TIMEOUT_SECONDS=30
KALMAN_SA_FEED_MAX_RETRIES=3
# Optional JSON object mapping source column -> canonical column.
# Example: {"symbol":"ticker","asOfDate":"date","quantScore":"quant_rating"}
KALMAN_SA_FIELD_MAP_JSON=

# Google Sheets ADC for the current CRYPTO archive bridge.
# rclone OAuth does NOT replace these credentials.
GOOGLE_APPLICATION_CREDENTIALS=/opt/kalman/secrets/google-service-account.json

# --- Toss Open API (NEVER commit real values) ---
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# accountSeq returned by GET /api/v1/accounts, not the full brokerage account number
TOSS_ACCOUNT=
HUB_GATEWAY_SECRET=
EXPECTED_EGRESS_IP=
# Shared by gateway + cron worker so they do not invalidate each other's OAuth token.
TOSS_TOKEN_CACHE=/opt/kalman/state/toss_oauth_token.json

# LIVE trading has TWO switches. Keep both closed until smoke/parity tests pass.
TRADING_ENABLED=false
LIVE_TRADING_CONFIRM=

# LIVE entry guardrails. Managed SELL exits are risk-reducing and are not blocked
# by entry notional caps, but they still require both global live gates.
LIVE_MICRO_TOTAL_LIMIT_KRW=30000
MAX_SINGLE_ORDER_KRW=5000
DEFAULT_SYMBOL_LIMIT_KRW=5000
QQQ_LIMIT_KRW=10000
NVDA_LIMIT_KRW=10000
IONQ_LIMIT_KRW=10000
# Use '*' only after explicitly deciding that the locked strategy may trade any selected US symbol.
ALLOW_SYMBOLS=QQQ,NVDA,IONQ
TRADING_STATE_DB=/opt/kalman/state/trading.sqlite3

# --- Automated DB -> Toss trade cycle ---
# DRY_RUN never submits. LIVE additionally requires a locked strategy version,
# explicit signal policy, the live gates above, fresh data, market-hours gate,
# local idempotency, and broker/account reconciliation.
AUTO_TRADE_ENABLED=false
AUTO_TRADE_EXECUTION_MODE=DRY_RUN
AUTO_TRADE_STRATEGY_VERSION=
AUTO_TRADE_REQUIRE_ACCOUNT_FLAT=true

# APPROVED_ONLY requires BUY + entry_allowed=true + PASS + payload.live_execution=true.
# SHADOW_CANARY does not alter the frozen DB signal, but requires explicit manual
# confirmation plus payload.allow_trade_shadow=true AND shadow_entry_this_signal=true.
AUTO_TRADE_SIGNAL_POLICY=APPROVED_ONLY
AUTO_TRADE_SHADOW_CONFIRM=

# Signal freshness: DRY_RUN can inspect yesterday's latest signal; LIVE remains strict.
AUTO_TRADE_DRY_RUN_MAX_SIGNAL_AGE_MINUTES=1440
AUTO_TRADE_MAX_SIGNAL_AGE_MINUTES=90

# Entry sizing. FIXED_USD preserves the current $2 canary default.
# CASH_FRACTION uses (cashBuyingPower - reserve) * fraction, then applies max/min.
AUTO_TRADE_SIZING_MODE=FIXED_USD
AUTO_TRADE_ORDER_USD=2
AUTO_TRADE_CASH_FRACTION=0.10
AUTO_TRADE_CASH_RESERVE_USD=0
AUTO_TRADE_MIN_ORDER_USD=1
AUTO_TRADE_MAX_ORDER_USD=2

# Exit horizon is intentionally fixed in code at 4 distinct US canonical signal buckets.

HOST=0.0.0.0
PORT=8787
