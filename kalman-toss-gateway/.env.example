# --- Kalman pipeline / Neon ---
DATABASE_URL_WRITER=
# Drive-backed state. scripts/install_gdrive.sh mounts gdrive: here at boot.
KALMAN_DATA_ROOT=/mnt/gdrive
KALMAN_ENV_FILE=/opt/kalman/.env

# KR authenticated freshness fallback
KRX_ID=
KRX_PW=

# US / macro inputs used by the existing Unified lineage
FRED_API_KEY=
ECOS_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Google Sheets ADC for the current CRYPTO archive bridge.
# rclone OAuth does NOT replace these credentials.
GOOGLE_APPLICATION_CREDENTIALS=/opt/kalman/secrets/google-service-account.json

# --- Toss Open API (NEVER commit real values) ---
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# accountSeq returned by GET /api/v1/accounts, not the full brokerage account number
TOSS_ACCOUNT=
HUB_GATEWAY_SECRET=
EXPECTED_EGRESS_IP=
# Shared by gateway + cron worker so they do not invalidate each other's OAuth token.
TOSS_TOKEN_CACHE=/opt/kalman/state/toss_oauth_token.json

# LIVE trading has TWO switches. Keep both closed until smoke/parity tests pass.
TRADING_ENABLED=false
LIVE_TRADING_CONFIRM=

# LIVE MICRO guardrails
LIVE_MICRO_TOTAL_LIMIT_KRW=30000
MAX_SINGLE_ORDER_KRW=5000
QQQ_LIMIT_KRW=10000
NVDA_LIMIT_KRW=10000
IONQ_LIMIT_KRW=10000
ALLOW_SYMBOLS=QQQ,NVDA,IONQ
TRADING_STATE_DB=/opt/kalman/state/trading.sqlite3

# Automated DB -> Toss bridge.
# Stage 1: AUTO_TRADE_ENABLED=true + DRY_RUN performs read-only account/order preview.
# DRY_RUN may inspect the most recent READY signal up to 24h old so broker plumbing can
# be verified before the US session. LIVE keeps the strict 90-minute freshness gate.
# Stage 2: LIVE additionally requires an exact approved strategy version, BUY/PASS/entry_allowed,
#          position_state=FLAT, payload.live_execution=true, and both LIVE trading gates above.
AUTO_TRADE_ENABLED=false
AUTO_TRADE_EXECUTION_MODE=DRY_RUN
AUTO_TRADE_STRATEGY_VERSION=
AUTO_TRADE_ORDER_USD=2
AUTO_TRADE_DRY_RUN_MAX_SIGNAL_AGE_MINUTES=1440
AUTO_TRADE_MAX_SIGNAL_AGE_MINUTES=90

HOST=0.0.0.0
PORT=8787
