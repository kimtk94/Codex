# --- Kalman pipeline / Neon ---
DATABASE_URL_WRITER=
# Drive-backed state. scripts/install_gdrive.sh mounts gdrive: here at boot.
KALMAN_DATA_ROOT=/mnt/gdrive
KALMAN_ENV_FILE=/opt/kalman/.env

# KR authenticated freshness fallback
KRX_ID=
KRX_PW=

# US / macro inputs used by the existing Unified lineage
FRED_API_KEY=
ECOS_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=


# --- News/Event Ingestion V1 (KR / US / CRYPTO / GLOBAL) ---
# Durable local spool: collection continues even when Neon or Google Drive is unavailable.
KALMAN_NEWS_CONFIG=/opt/kalman/app/config/news-ingest-v1.json
KALMAN_NEWS_ENTITY_ALIASES=/opt/kalman/app/config/news-entity-aliases-v2.json
KALMAN_NEWS_SPOOL_DB=/var/lib/kalman/news/news_spool.sqlite3
KALMAN_NEWS_STATE_DIR=/opt/kalman/state/news
KALMAN_NEWS_DRIVE_ROOT=/mnt/gdrive/Market_News/v1/raw
KALMAN_NEWS_COVERAGE_STATUS=/opt/kalman/state/news/coverage_status.json
KALMAN_NEWS_USER_AGENT=KalmanNews/1.0
# SEC asks automated clients to identify themselves with contact information.
KALMAN_NEWS_SEC_USER_AGENT=
# Runtime gate for SEC collection. Set false when the server IP is blocked by SEC.
KALMAN_NEWS_SEC_ENABLED=false
# OpenDART corporate disclosures. Keep the runtime gate off until a key is configured.
KALMAN_NEWS_DART_ENABLED=false
DART_API_KEY=
# Keep Neon sync closed until research/quant_stack/news_ingest_v1.sql is promoted.
KALMAN_NEWS_NEON_SYNC_ENABLED=false
KALMAN_NEWS_DRIVE_SYNC_ENABLED=true
# Fallback universe only; normally latest US/KR/CRYPTO symbols are read from Neon model_output.
KALMAN_NEWS_US_SYMBOLS=
KALMAN_NEWS_KR_SYMBOLS=
KALMAN_NEWS_CRYPTO_SYMBOLS=BTC,ETH

# --- Macro Event Feature Layer V1 (CHALLENGER ONLY) ---
# Writes only public.news_feature_snapshot with feature_version=macro-event-feature-v1.
# It does not alter R5.1 scoring or trade gates.
KALMAN_MACRO_FEATURES_ENABLED=false
KALMAN_MACRO_FEATURE_CONFIG=/opt/kalman/app/config/macro-event-features-v1.json
# Optional licensed consensus calendar adapter. Keep OFF unless an API credential is configured.
KALMAN_MACRO_CONSENSUS_ENABLED=false
TRADING_ECONOMICS_API_KEY=

# --- Macro Shadow Evaluation V1 (RESEARCH ONLY) ---
# Forward-only PIT join between matured R5.1 benchmark outcomes and macro snapshots.
# It does not alter R5.1 signals or trade execution.
KALMAN_MACRO_SHADOW_EVAL_ENABLED=false
KALMAN_MACRO_SHADOW_EVAL_CONFIG=/opt/kalman/app/config/macro-shadow-eval-v1.json

# --- Market Tools V2 (SHADOW ONLY) ---
# Dependencies are installed into /opt/kalman/.venv-market-v2, not production.
KALMAN_MARKET_V2_OUTPUT_DIR=/mnt/gdrive/Market_Data/v2
KALMAN_MARKET_V2_START_DATE=2024-01-01
KALMAN_MARKET_V2_END_DATE=
KALMAN_MARKET_V2_UNIVERSE=/opt/kalman/app/config/market-data-v2-universe.json
KALMAN_FEATURES_V2_OUTPUT_DIR=/mnt/gdrive/Market_Features/v2

# Finviz scraping is OFF by default. Enable only after a successful manual run.
KALMAN_FINVIZ_ENABLED=false
KALMAN_FINVIZ_OUTPUT_DIR=/mnt/gdrive/Market_Screeners/finviz
KALMAN_FINVIZ_LIMIT=500
# Must be valid finvizfinance filter names/options. Example: {"Index":"S&P 500"}
KALMAN_FINVIZ_FILTERS_JSON=
KALMAN_FINVIZ_SIGNAL=
# Local post-fetch filters; 0 disables each filter.
KALMAN_FINVIZ_MIN_PRICE=0
KALMAN_FINVIZ_MIN_MARKET_CAP=0
KALMAN_FINVIZ_MIN_VOLUME=0

# --- Model V2 (RESEARCH / SHADOW) ---
KALMAN_MODEL_V2_SPEC=/opt/kalman/app/config/model-v2-spec.json
KALMAN_MODEL_V2_ROOT=/mnt/gdrive/Market_Model_V2
KALMAN_MODEL_V2_MAX_MISSING_FEATURE_RATIO=0.15

# Optional Neon SHADOW mirror. OFF by default.
# When enabled it mirrors model_registry/model_output/strategy_signal only.
# It intentionally creates NO dashboard_snapshot and writes pipeline_run as ABORTED,
# so v_latest_successful_run and auto_trade remain isolated.
KALMAN_MODEL_V2_NEON_ENABLED=false
KALMAN_MODEL_V2_NEON_CONFIRM=
# Exact confirmation value when intentionally enabling:
# KALMAN_MODEL_V2_NEON_CONFIRM=CONFIRM_NEON_SHADOW_MIRROR

# --- Seeking Alpha x US x BTC ---
# Canonical history consumed by the feature worker.
KALMAN_SA_INPUT_CSV=/mnt/gdrive/SeekingAlpha/seeking_alpha_daily.csv
KALMAN_SA_OUTPUT_DIR=/mnt/gdrive/Market_Features/sa_us_btc
KALMAN_SA_START_DATE=2022-01-01
KALMAN_SA_END_DATE=
# 0 only when the SA snapshot is available before the modeled market session.
KALMAN_SA_ASOF_LAG_BDAYS=0
# Keep false until SA data is mandatory for production.
KALMAN_SA_REQUIRED=false

# Collector mode: disabled | drop_csv | licensed_http
# Do not automate scraping of the normal SA website. licensed_http is for an
# authorized/licensed API or data feed supplied for your account/partnership.
KALMAN_SA_COLLECTOR_MODE=disabled

# drop_csv mode: a permitted/exported file placed here is normalized + accumulated.
KALMAN_SA_DROP_CSV=/mnt/gdrive/SeekingAlpha/incoming/seeking_alpha_latest.csv
KALMAN_SA_ARCHIVE_DIR=/mnt/gdrive/SeekingAlpha/archive
KALMAN_SA_COLLECTOR_STATE=/opt/kalman/state/sa_collector.json

# licensed_http mode: keep the real endpoint/token only in /opt/kalman/.env.
KALMAN_SA_FEED_URL=
KALMAN_SA_FEED_TOKEN=
KALMAN_SA_FEED_AUTH_HEADER=Authorization
KALMAN_SA_FEED_AUTH_SCHEME=Bearer
KALMAN_SA_FEED_FORMAT=auto
# Optional dotted JSON path, e.g. data.rows. Blank auto-detects data/results/rows/items.
KALMAN_SA_FEED_JSON_PATH=
KALMAN_SA_FEED_TIMEOUT_SECONDS=30
KALMAN_SA_FEED_MAX_RETRIES=3
# Optional JSON object mapping source column -> canonical column.
# Example: {"symbol":"ticker","asOfDate":"date","quantScore":"quant_rating"}
KALMAN_SA_FIELD_MAP_JSON=

# Google Sheets ADC for the current CRYPTO archive bridge.
# rclone OAuth does NOT replace these credentials.
GOOGLE_APPLICATION_CREDENTIALS=/opt/kalman/secrets/google-service-account.json

# --- Toss Open API (NEVER commit real values) ---
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# accountSeq returned by GET /api/v1/accounts, not the full brokerage account number
TOSS_ACCOUNT=
HUB_GATEWAY_SECRET=
EXPECTED_EGRESS_IP=
# Shared by gateway + cron worker so they do not invalidate each other's OAuth token.
TOSS_TOKEN_CACHE=/opt/kalman/state/toss_oauth_token.json

# LIVE trading has TWO switches. Keep both closed until smoke/parity tests pass.
TRADING_ENABLED=false
LIVE_TRADING_CONFIRM=

# LIVE entry guardrails. There is no symbol allowlist: any strategy-selected
# symbol may proceed only if the global live gates and notional controls pass.
# Managed SELL exits are risk-reducing and still require both global live gates.
LIVE_MICRO_TOTAL_LIMIT_KRW=30000
MAX_SINGLE_ORDER_KRW=5000
TRADING_STATE_DB=/opt/kalman/state/trading.sqlite3

# --- Automated DB -> Toss trade cycle ---
# DRY_RUN never submits. LIVE additionally requires a locked strategy version,
# explicit signal policy, the live gates above, fresh data, market-hours gate,
# local idempotency, and broker/account reconciliation.
AUTO_TRADE_ENABLED=false
AUTO_TRADE_EXECUTION_MODE=DRY_RUN
AUTO_TRADE_STRATEGY_VERSION=
AUTO_TRADE_REQUIRE_ACCOUNT_FLAT=true
AUTO_TRADE_MAX_ACTIVE_POSITIONS=3

# Same-symbol pyramiding is disabled unless MAX_ENTRIES_PER_SYMBOL > 1.
# LIVE R5 profile uses 3 x KRW 5,000 entries, at least one completed 60m bucket apart.
AUTO_TRADE_MAX_ENTRIES_PER_SYMBOL=1
AUTO_TRADE_ADD_ON_MIN_BUCKET_GAP=1
AUTO_TRADE_MAX_SYMBOL_NOTIONAL_KRW=5000

# APPROVED_ONLY requires BUY + entry_allowed=true + PASS + payload.live_execution=true.
# SHADOW_CANARY does not alter the frozen DB signal, but requires explicit manual
# confirmation plus payload.allow_trade_shadow=true AND shadow_entry_this_signal=true.
AUTO_TRADE_SIGNAL_POLICY=APPROVED_ONLY
AUTO_TRADE_SHADOW_CONFIRM=

# Signal freshness: DRY_RUN can inspect yesterday's latest signal; LIVE remains strict.
AUTO_TRADE_DRY_RUN_MAX_SIGNAL_AGE_MINUTES=1440
AUTO_TRADE_MAX_SIGNAL_AGE_MINUTES=90

# Entry sizing. FIXED_USD preserves the current $2 canary default.
# CASH_FRACTION uses (cashBuyingPower - reserve) * fraction, then applies max/min.
AUTO_TRADE_SIZING_MODE=FIXED_USD
AUTO_TRADE_ORDER_USD=2
AUTO_TRADE_ORDER_KRW=5000
AUTO_TRADE_CASH_FRACTION=0.10
AUTO_TRADE_CASH_RESERVE_USD=0
AUTO_TRADE_MIN_ORDER_USD=1
AUTO_TRADE_MAX_ORDER_USD=2

# Exit horizon is intentionally fixed in code at 4 distinct US canonical signal buckets.
# After a LIVE exit is submitted, the position manager polls briefly for a
# terminal fill so a confirmed close can release the same worker cycle to BUY.
# Timeout/partial/unresolved exits remain active and block a fresh entry.
AUTO_TRADE_EXIT_FILL_WAIT_SECONDS=45
AUTO_TRADE_EXIT_POLL_SECONDS=1

HOST=0.0.0.0
PORT=8787
