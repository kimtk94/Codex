# Toss Open API credentials (NEVER commit real values)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT=

# Gateway auth shared only between Investment Hub and this server
HUB_GATEWAY_SECRET=

# Full public egress IP of the server; keep the real value in server env only
EXPECTED_EGRESS_IP=

# Safety defaults for LIVE MICRO test
TRADING_ENABLED=false
LIVE_MICRO_TOTAL_LIMIT_KRW=30000
MAX_SINGLE_ORDER_KRW=5000
QQQ_LIMIT_KRW=10000
NVDA_LIMIT_KRW=10000
IONQ_LIMIT_KRW=10000
ALLOW_SYMBOLS=QQQ,NVDA,IONQ

# Optional runtime
HOST=0.0.0.0
PORT=8787
