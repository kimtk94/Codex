{
  "version": "kalman_quant_stack_v1_001",
  "mode": "BACKTEST",
  "start_date": "2017-01-01",
  "walk_forward": {
    "train_observations": 504,
    "validation_observations": 63,
    "test_observations": 126,
    "purge_policy": "MARKET_HORIZON",
    "expanding": true
  },
  "signal_policy": {
    "entry": "probability >= probability_threshold",
    "exit": "probability <= 1 - probability_threshold",
    "otherwise": "HOLD",
    "position_state_owner": "NATIVE_LEDGER"
  },
  "execution": {
    "fill": "STRICT_NEXT_BAR_OPEN",
    "initial_cash": 1000000,
    "position_fraction": 0.1,
    "max_open_positions": 1,
    "commission_bps": 5,
    "slippage_bps": 5,
    "max_hold_bars": 20,
    "allow_fractional": true
  },
  "annualization": {
    "equity_sampling": "DAILY_LAST",
    "trading_days": 252
  },
  "safety": {
    "research_only": true,
    "neon_write": false,
    "live_execution": false,
    "toss_execution": false,
    "require_raw_anchor_ohlc": true
  },
  "qlib": {
    "enabled_by_default": false,
    "package": "pyqlib==0.9.7",
    "role": "EXPERIMENT_RECORDER_ONLY",
    "authoritative_data_source": "KALMAN",
    "authoritative_execution_engine": "KALMAN_NATIVE_LEDGER",
    "tracking_uri_policy": "RELATIVE_FILE_URI_UNDER_CONTROLLED_CWD",
    "server_tracking_root_env": "KALMAN_QLIB_TRACKING_ROOT",
    "server_provider_root_env": "KALMAN_QLIB_PROVIDER_ROOT"
  }
}
