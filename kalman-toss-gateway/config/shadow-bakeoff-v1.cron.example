# Kalman Forward SHADOW Bake-off V1 cron template
# Canonical installer:
#   sudo /bin/bash /opt/kalman/app/scripts/install_shadow_bakeoff_v1_cron.sh --install
#
# CRON_TZ=Asia/Seoul
# SHELL=/bin/bash
# PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
#
# Tue-Sat 08:10 KST:
# 10 8 * * 2-6 root /bin/bash /opt/kalman/app/scripts/run_shadow_bakeoff_daily.sh >> /opt/kalman/logs/shadow-bakeoff-v1.log 2>&1
#
# Flow:
#   current V2 Market Data / Features refresh
#     -> historical integrated source freshness gate
#       -> if stale: WAITING_SOURCE_REFRESH, exit 0
#       -> if fresh: matrix refresh + A/B/C forward bakeoff
#
# Safety:
#   production_write=false
#   neon_write=false
#   toss_execution=false
#   live_execution=false
#   dashboard visibility=false
#
# IMPORTANT:
# Current Market Data V2 refresh does NOT itself rewrite the historical_2017
# integrated raw/features lineage. The freshness gate intentionally prevents
# stale seed data from being presented as new forward evidence.
