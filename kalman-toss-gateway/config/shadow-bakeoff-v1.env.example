# Kalman Forward SHADOW Bake-off V1 settings
# Copy only the keys you want into /opt/kalman/.env.
#
# Safe defaults:
KALMAN_SHADOW_BAKEOFF_REFRESH_CURRENT_V2=true
KALMAN_SHADOW_BAKEOFF_SEED_END=2026-09-11T00:00:00+00:00

# Optional hook that must rebuild/refresh BOTH integrated historical sources:
#   Market_Data/v2/raw/historical_2017/multimarket_raw_2017_present.parquet
#   Market_Features/v2/talib/historical_2017/multimarket_features_2017_present_v0_3.parquet
#
# Leave empty until a validated historical-source refresh executable exists.
KALMAN_SHADOW_BAKEOFF_SOURCE_REFRESH_SCRIPT=

# Optional path overrides:
# KALMAN_SHADOW_BAKEOFF_OUTPUT_DIR=/mnt/gdrive/Market_Model_V2/shadow_bakeoff/v1
# KALMAN_SHADOW_BAKEOFF_HIST_RAW=/mnt/gdrive/Market_Data/v2/raw/historical_2017/multimarket_raw_2017_present.parquet
# KALMAN_SHADOW_BAKEOFF_HIST_FEATURES=/mnt/gdrive/Market_Features/v2/talib/historical_2017/multimarket_features_2017_present_v0_3.parquet

# Safety is enforced by code. Do NOT set these to enable trading for this workflow:
# TRADING_ENABLED=false
# LIVE_TRADING_CONFIRM=
