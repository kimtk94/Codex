# Kalman server schedule. Install for root or a dedicated kalman user with /opt/kalman permissions.
CRON_TZ=Asia/Seoul
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Crypto: refresh each hour. CRYPTO_GLOBAL also rebuilds cross-market summary.
5 * * * * /opt/kalman/app/scripts/run_pipeline.sh CRYPTO_GLOBAL >> /opt/kalman/logs/crypto.log 2>&1

# KR: after regular market close on weekdays. Exchange-calendar QC inside the pipeline remains fail-closed.
20 16 * * 1-5 /opt/kalman/app/scripts/run_pipeline.sh KR_GLOBAL >> /opt/kalman/logs/kr.log 2>&1

# US R5.1: serialize each completed-bar pipeline with its matching trade decision.
35 23 * * 1-5 /opt/kalman/app/scripts/run_us_cycle.sh >> /opt/kalman/logs/us-cycle.log 2>&1
35 0-4 * * 2-6 /opt/kalman/app/scripts/run_us_cycle.sh >> /opt/kalman/logs/us-cycle.log 2>&1

# Execution-only catch-up/risk watcher. The script self-serializes with the
# hourly US cycle and keeps the model signal cadence at 60 minutes.
# :35 is reserved for the model cycle and :50 for the watchdog.
25-55/5 22 * * 1-5 /opt/kalman/app/scripts/run_execution_watch.sh >> /opt/kalman/logs/execution-watch.log 2>&1
0,5,10,15,20,25,30,40,45,55 23 * * 1-5 /opt/kalman/app/scripts/run_execution_watch.sh >> /opt/kalman/logs/execution-watch.log 2>&1
0,5,10,15,20,25,30,40,45,55 0-4 * * 2-6 /opt/kalman/app/scripts/run_execution_watch.sh >> /opt/kalman/logs/execution-watch.log 2>&1
*/5 5 * * 2-6 /opt/kalman/app/scripts/run_execution_watch.sh >> /opt/kalman/logs/execution-watch.log 2>&1
