# Kalman server schedule. Install for root or a dedicated kalman user with /opt/kalman permissions.
CRON_TZ=Asia/Seoul
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Crypto: refresh each hour. CRYPTO_GLOBAL also rebuilds cross-market summary.
5 * * * * /opt/kalman/app/scripts/run_pipeline.sh CRYPTO_GLOBAL >> /opt/kalman/logs/crypto.log 2>&1

# KR: after regular market close on weekdays. Exchange-calendar QC inside the pipeline remains fail-closed.
20 16 * * 1-5 /opt/kalman/app/scripts/run_pipeline.sh KR_GLOBAL >> /opt/kalman/logs/kr.log 2>&1

# US R5.1: refresh only after a market-open-aligned 60m bar is complete (+2m safety delay).
# This dual DST/standard window keeps the signal inside AUTO_TRADE_MAX_SIGNAL_AGE_MINUTES=90.
35 23 * * 1-5 /opt/kalman/app/scripts/run_pipeline.sh US >> /opt/kalman/logs/us.log 2>&1
35 0-4 * * 2-6 /opt/kalman/app/scripts/run_pipeline.sh US >> /opt/kalman/logs/us.log 2>&1

# Live executor: 10 minutes after each completed-bar refresh.
45 23 * * 1-5 /opt/kalman/app/scripts/run_auto_trade.sh >> /opt/kalman/logs/auto-trade.log 2>&1
45 0-4 * * 2-6 /opt/kalman/app/scripts/run_auto_trade.sh >> /opt/kalman/logs/auto-trade.log 2>&1
