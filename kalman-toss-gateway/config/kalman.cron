# Kalman server schedule. Install for root or a dedicated kalman user with /opt/kalman permissions.
CRON_TZ=Asia/Seoul
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Crypto: refresh each hour. CRYPTO_GLOBAL also rebuilds cross-market summary.
5 * * * * /opt/kalman/app/scripts/run_pipeline.sh CRYPTO_GLOBAL >> /opt/kalman/logs/crypto.log 2>&1

# KR: after regular market close on weekdays. Exchange-calendar QC inside the pipeline remains fail-closed.
20 16 * * 1-5 /opt/kalman/app/scripts/run_pipeline.sh KR_GLOBAL >> /opt/kalman/logs/kr.log 2>&1

# US: DST/standard-time opening pulses followed by hourly overnight refresh.
35 22-23 * * 1-5 /opt/kalman/app/scripts/run_pipeline.sh US >> /opt/kalman/logs/us.log 2>&1
15 0-6 * * 2-6 /opt/kalman/app/scripts/run_pipeline.sh US >> /opt/kalman/logs/us.log 2>&1

# Live executor: 10 minutes after each US refresh. Broker market calendar remains the final session gate.
45 22-23 * * 1-5 /opt/kalman/app/scripts/run_auto_trade.sh >> /opt/kalman/logs/auto-trade.log 2>&1
25 0-6 * * 2-6 /opt/kalman/app/scripts/run_auto_trade.sh >> /opt/kalman/logs/auto-trade.log 2>&1
