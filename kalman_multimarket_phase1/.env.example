# Kalman Multi-Market Phase 1 Collector
# Copy to .env and fill secrets locally/server-side.
# NEVER commit real secrets to Git or Drive.

DATA_DIR=./data
LOOKBACK_DAYS=420
HTTP_TIMEOUT=20
LOG_LEVEL=INFO

# Alpaca Market Data
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex

# FRED
FRED_API_KEY=

# Bank of Korea ECOS (optional; if absent/mapping incomplete, FDR fallback is used)
BOK_ECOS_API_KEY=

# Pin exact ECOS StatisticSearch mappings after verifying them in ECOS.
# The collector intentionally does not guess codes.
ECOS_KR3Y_STAT_CODE=
ECOS_KR3Y_CYCLE=D
ECOS_KR3Y_ITEM_CODE1=

ECOS_KR10Y_STAT_CODE=
ECOS_KR10Y_CYCLE=D
ECOS_KR10Y_ITEM_CODE1=

ECOS_USDKRW_STAT_CODE=
ECOS_USDKRW_CYCLE=D
ECOS_USDKRW_ITEM_CODE1=

# Leakage-safety policy inherited from Investment Hub
MACRO_US_LAG_DAYS=2
MACRO_KR_LAG_DAYS=1
STALE_DAILY_HOURS=72
